# OS
Thumbs.db
desktop.ini
.DS_Store

# 临时目录
.tmp/

# IDE
.idea/
*.iml
.vscode/
*.swp

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Node / 前端
node_modules/
dist/
.pnpm-store/

# Java（若后端改用 JVM 技术栈）
target/
*.class

# 环境与密钥
.env
.env.*
!.env.example
*.pem
*.key

# 日志与运行时产物
*.log
/uploads/

# 数据库备份（体积大，只在本地保留）
项目代码/数据库/backup/*
!项目代码/数据库/backup/.gitkeep

# 实验原始结果与日志（可复现即可重建）
数据实验/实验/results/raw/*
!数据实验/实验/results/raw/.gitkeep
数据实验/实验/logs/*
!数据实验/实验/logs/.gitkeep

# 论文文献原文（版权原因，仅本地保留）
开题与论文/论文/references/pdfs/*.pdf

# 论文中间产物
~$*
*.tmp.docx
